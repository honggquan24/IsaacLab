      <geom name="base_vis" type="box" size="0.12 0.08 0.04" pos="0.1 -0.27 0.23"/>

      <!-- ══════════════════════════════════════════════════
           RIGHT SIDE
           pad_joint_right: xyz="-0.01454 -0.16846 0.15344"  rpy="-π 0 π"
           ══════════════════════════════════════════════════ -->
      <body name="pad_link_right"
            pos="-0.0145352566206275 -0.168456056407975 0.153440174945304"
