              <!-- TIP SITE — used as anchor for equality constraint -->
              <site name="calf_right_2_tip" pos="-0.18 -0.001 0" size="0.005"/>
            </body>
          </body>

        </body><!-- hip_frame_link_right -->
      </body><!-- pad_link_right -->

      <!-- ══════════════════════════════════════════════════
           LEFT SIDE
           pad_joint_left: xyz="0.21546 -0.37846 0.15344"  rpy="π 0 0"
           ══════════════════════════════════════════════════ -->
      <body name="pad_link_left"
            pos="0.215464743379373 -0.378456056407975 0.153440174945304"
