        <geom name="pad_left_vis" type="box" size="0.03 0.05 0.01" pos="0 -0.105 0"/>

        <!-- hil_frame_joint_left (typo in original URDF): xyz="0.01 -0.105 0.097"  rpy="0 0 -π/2" -->
        <body name="hip_frame_link_left"
              pos="0.01 -0.105 0.097"
              euler="0 0 -1.5707963267949">
          <inertial pos="-0.0078753503216839 0.0307485208640013 0"
                    mass="1.51193274122872"
                    fullinertia="0.00230798720358944 0.00722477501190135 0.00595941566724504
                                 0.000347926290296318 -1.35078386623163e-18 8.40488619506597e-20"/>
          <geom name="hip_frame_left_vis" type="box" size="0.06 0.04 0.02" pos="-0.008 0.031 0"/>

          <!-- ── ACTIVE CHAIN (left) ───────────────────────────── -->
          <!-- thigh_joint_left_1: xyz="0.0510 0.06 0"  rpy="π -1.10060 0" -->
          <body name="thigh_left_1"
                pos="0.0509999999999999 0.06 0"
                euler="3.14159265358979 -1.10060010562748 0">
            <joint name="thigh_joint_left_1" type="hinge" axis="0 1 0"
                   range="-3.14159 3.14159"/>
            <inertial pos="0.07 -0.00649999999999995 0"
