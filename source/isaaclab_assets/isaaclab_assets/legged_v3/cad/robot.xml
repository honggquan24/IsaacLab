        <geom name="pad_right_vis" type="box" size="0.03 0.05 0.01" pos="0 -0.105 0"/>

        <!-- hip_frame_joint_right: xyz="0.01 -0.105 0.097"  rpy="0 0 π/2" -->
        <body name="hip_frame_link_right"
              pos="0.01 -0.105 0.097"
              euler="0 0 1.5707963267949">
          <inertial pos="-0.00787535032168385 -0.0307485208640013 0"
                    mass="1.51193274122872"
                    fullinertia="0.00230798720358944 0.00722477501190136 0.00595941566724505
