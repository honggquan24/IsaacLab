          </body>

        </body><!-- hip_frame_link_left -->
      </body><!-- pad_link_left -->

    </body><!-- base_link -->
  </worldbody>

  <!-- ======================================================
       EQUALITY CONSTRAINTS — close the parallel linkage loops
       weld body1=passive_calf_tip to body2=foot (wheel)
       relpose: position and quaternion [w x y z] of body2 in body1 frame
       NOTE: relpose="0 0 0 1 0 0 0" assumes origins coincide at default config.
             If the robot sags or explodes on load, tune relpose or use
             the connect type with explicit anchor positions.
       ====================================================== -->
  <equality>
    <weld name="close_loop_right"
          body1="calf_right_link_2" body2="wheel_link_right"
          relpose="0 0 0 1 0 0 0"
          solimp="0.9 0.95 0.001" solref="0.02 1"/>
    <weld name="close_loop_left"
          body1="calf_left_link_2" body2="wheel_link_left"
          relpose="0 0 0 1 0 0 0"
          solimp="0.9 0.95 0.001" solref="0.02 1"/>
  </equality>

  <!-- ======================================================
       ACTUATORS — drive only the active chain joints
       thigh_*_2 and calf_*_2 are passive (driven by linkage constraint)
       ====================================================== -->
  <actuator>
    <motor name="act_thigh_right_1" joint="thigh_joint_right_1"
           gear="1" ctrllimited="true" ctrlrange="-20 20"/>
    <motor name="act_calf_right_1"  joint="calf_joint_right_1"
           gear="1" ctrllimited="true" ctrlrange="-20 20"/>
    <motor name="act_thigh_left_1"  joint="thigh_joint_left_1"
           gear="1" ctrllimited="true" ctrlrange="-20 20"/>
    <motor name="act_calf_left_1"   joint="calf_joint_left_1"
           gear="1" ctrllimited="true" ctrlrange="-20 20"/>
  </actuator>

</mujoco>
