<mujoco model="simplified_robot">

  <!--
    Converted from: simplified/urdf/robot.SLDASM/urdf/robot.SLDASM.urdf
    Structure:
      base_link
      ├── pad_link_right (fixed) → hip_frame_link_right (fixed)
      │     ├── thigh_right_1 → calf_right_link_1 → wheel_link_right  [ACTIVE chain]
      │     └── thigh_right_2 → calf_right_link_2                     [PASSIVE chain - loop closed via equality]
      └── pad_link_left  (fixed) → hip_frame_link_left (fixed)
            ├── thigh_left_1  → calf_left_link_1  → wheel_link_left   [ACTIVE chain]
            └── thigh_left_2  → calf_left_link_2                      [PASSIVE chain - loop closed via equality]

    Equality constraints close the 5-bar parallel linkage loop:
      calf_right_link_2 tip ↔ wheel_link_right
      calf_left_link_2  tip ↔ wheel_link_left

    NOTE: relpose in <weld> may need tuning based on actual geometry.
    NOTE: Replace geom type="box/cylinder" placeholders with type="mesh" once STL files are available.
    MESHDIR: point meshdir to the folder containing your STL files.
  -->

  <compiler angle="radian" eulerseq="XYZ" meshdir="urdf/robot.SLDASM/meshes/"/>

  <option gravity="0 0 -9.81" timestep="0.002"/>

  <default>
    <joint damping="0.1" armature="0.01"/>
    <geom contype="0" conaffinity="0" rgba="0.8 0.82 0.93 1"/>
  </default>

  <!-- ======================================================
       ASSETS — swap type="mesh" once STL files are ready
       ====================================================== -->
  <asset>
    <!-- Uncomment when STL files are available:
    <mesh name="base_link"           file="base_link.STL"/>
    <mesh name="pad_link_right"      file="pad_link_right.STL"/>
    <mesh name="hip_frame_link_right" file="hip_frame_link_right.STL"/>
    <mesh name="thigh_right_1"       file="thigh_right_1.STL"/>
    <mesh name="calf_right_link_1"   file="calf_right_link_1.STL"/>
    <mesh name="wheel_link_right"    file="wheel_link_right.STL"/>
    <mesh name="thigh_right_2"       file="thigh_right_2.STL"/>
    <mesh name="calf_right_link_2"   file="calf_right_link_2.STL"/>
    <mesh name="pad_link_left"       file="pad_link_left.STL"/>
    <mesh name="hip_frame_link_left" file="hip_frame_link_left.STL"/>
    <mesh name="thigh_left_1"        file="thigh_left_1.STL"/>
    <mesh name="calf_left_link_1"    file="calf_left_link_1.STL"/>
    <mesh name="wheel_link_left"     file="wheel_link_left.STL"/>
    <mesh name="thigh_left_2"        file="thigh_left_2.STL"/>
    <mesh name="calf_left_link_2"    file="calf_left_link_2.STL"/>
    -->
  </asset>

  <!-- ======================================================
       WORLD BODY
       ====================================================== -->
  <worldbody>

    <!-- Ground plane -->
    <geom name="floor" type="plane" size="5 5 0.1" pos="0 0 0"
          contype="1" conaffinity="1" rgba="0.5 0.5 0.5 1"/>

    <!-- ── BASE ────────────────────────────────────────────── -->
    <!-- Spawned 0.5m above ground; freejoint allows it to fall/move freely -->
    <body name="base_link" pos="0 0 0.5">
      <freejoint name="root"/>
      <inertial pos="0.100464743379373 -0.273417797162494 0.231369380364405"
                mass="8.12765796417228"
                fullinertia="0.113381267165392 0.104302535100205 0.193324449577809
                             -1.10883716950187e-17 6.53856800641098e-18 7.39699722855432e-05"/>
