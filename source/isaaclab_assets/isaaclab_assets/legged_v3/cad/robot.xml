                      contype="1" conaffinity="1" rgba="0.2 0.2 0.8 1"/>
              </body>
            </body>
          </body>

          <!-- ── PASSIVE CHAIN (right) — loop broken here ─────── -->
          <!-- thigh_joint_right_2: xyz="-0.0510 -0.078 0"  rpy="0 -0.88686 π" -->
          <body name="thigh_right_2"
                pos="-0.0510000000000018 -0.078 0"
                euler="0 -0.886862904121189 3.14159265358979">
            <joint name="thigh_joint_right_2" type="hinge" axis="0 1 0"
                   range="-3.14159 3.14159"/>
            <inertial pos="0.0699999999999911 0.00649999999999999 0"
                      mass="0.116525440310417"
                      fullinertia="2.45877499995411e-05 0.000338559690951382 0.000317254074187251
                                   6.9352432719385e-22 1.05707424828379e-15 -2.84526358354157e-21"/>
            <geom name="thigh_right_2_vis" type="capsule" size="0.013" fromto="0 0 0 0.14 0.013 0"/>

            <!-- calf_joint_right_2: xyz="0.140 0.013 0"  rpy="π 1.39897 π" -->
            <body name="calf_right_link_2"
                  pos="0.140000000000064 0.013 0"
