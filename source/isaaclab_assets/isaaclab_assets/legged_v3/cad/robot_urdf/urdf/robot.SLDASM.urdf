<?xml version='1.0' encoding='UTF-8'?>
<!-- Legged Robot V3 — STL visuals + box collision shapes (lightweight for PhysX).
     Wheel foot_links keep cylinder primitive for smooth rolling contact.
     Inertial properties from SolidWorks export (robot.SLDASM.csv). -->
<robot name="robot.SLDASM">

  <!-- ══════════════════ BASE ══════════════════ -->

  <link name="base_link">
    <inertial>
      <origin xyz="0.119 -0.0078995 -0.10019" rpy="0 0 0"/>
      <mass value="4.6492729048"/>
      <inertia ixx="1.993716E-02" ixy="7.713020E-18" ixz="-2.271684E-18" iyy="4.662480E-02" iyz="1.112191E-18" izz="3.272955E-02"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/base_link.STL"/></geometry>
      <material name=""><color rgba="0.79216 0.81961 0.93333 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.12 0.09 0.0" rpy="0 0 0"/>
      <geometry><box size="0.35 0.2 0.2"/></geometry>
    </collision>
  </link>

  <!-- ══════════════════ LEFT LEG ══════════════════ -->

  <link name="left_thigh_link_A1">
    <inertial>
      <origin xyz="0.07 -0.0065 0" rpy="0 0 0"/>
      <mass value="0.1476182766"/>
      <inertia ixx="3.114851E-05" ixy="0.000000E+00" ixz="0.000000E+00" iyy="4.288990E-04" iyz="0.000000E+00" izz="4.019078E-04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/left_thigh_link_A1.STL"/></geometry>
      <material name=""><color rgba="0.792156 0.819607 0.933333 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.07 0 0" rpy="0 0 0"/>
      <geometry><box size="0.14 0.025 0.025"/></geometry>
    </collision>
  </link>
  <joint name="left_hip_joint_A1" type="revolute">
    <origin xyz="0.316 0.054 -0.06" rpy="3.1416 0.93114 -1.5708"/>
    <parent link="base_link"/>
    <child link="left_thigh_link_A1"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.7745" upper="0.7745" effort="20" velocity="50"/>
  </joint>

  <link name="left_shin_link_B1">
    <inertial>
      <origin xyz="-0.09 -0.0065 0" rpy="0 0 0"/>
      <mass value="0.1805684146"/>
      <inertia ixx="3.847714E-05" ixy="0.000000E+00" ixz="0.000000E+00" iyy="7.649134E-04" iyz="0.000000E+00" izz="7.315225E-04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/left_shin_link_B1.STL"/></geometry>
      <material name=""><color rgba="0.792156 0.819607 0.933333 1"/></material>
    </visual>
    <collision>
      <origin xyz="-0.09 0 0" rpy="0 0 0"/>
      <geometry><box size="0.18 0.025 0.025"/></geometry>
    </collision>
  </link>
  <joint name="left_knee_joint_B1" type="revolute">
    <origin xyz="0.14 -0.013 0" rpy="3.1416 1.4115 3.1416"/>
    <parent link="left_thigh_link_A1"/>
    <child link="left_shin_link_B1"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.7745" upper="0.7745" effort="20" velocity="50"/>
  </joint>

  <link name="left_foot_link">
    <inertial>
      <origin xyz="0 -0.015 0" rpy="0 0 0"/>
      <mass value="0.2960462476"/>
      <inertia ixx="2.084159E-04" ixy="0.000000E+00" ixz="0.000000E+00" iyy="3.724259E-04" iyz="0.000000E+00" izz="2.084159E-04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/left_foot_link.STL"/></geometry>
      <material name=""><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <!-- Cylinder primitive cho bánh xe — smooth rolling contact -->
    <collision>
      <origin xyz="0 -0.0225 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0765" length="0.045"/></geometry>
    </collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="-0.18 0 0" rpy="0 -0.77181 3.1416"/>
    <parent link="left_shin_link_B1"/>
    <child link="left_foot_link"/>
    <axis xyz="0 1 0"/>
